/**
* Powermenu — Black & White theme
**/

configuration {
  show-icons: false;
}

@import "shared/colors.rasi"
@import "shared/fonts.rasi"

* {
  background-color: transparent;
  text-color:       #e8e8e8;
}

window {
  transparency:     "real";
  location:         north;
  anchor:           north;
  fullscreen:       false;
  width:            480px;
  x-offset:         0px;
  y-offset:         8px;
  margin:           0px;
  padding:          0px;
  border:           1px solid;
  border-radius:    0px;
  border-color:     #333333;
  background-color: #0a0a0a;
}

mainbox {
  spacing:          12px;
  padding:          14px 18px;
  background-color: transparent;
  children:         [ "inputbar", "listview" ];
}

inputbar {
  spacing:          12px;
  padding:          0px;
  background-color: transparent;
  text-color:       #e8e8e8;
  children:         [ "prompt" ];
}

prompt {
  enabled:          true;
  padding:          6px 12px;
  border-radius:    0px;
  background-color: #1a1a1a;
  text-color:       #888888;
}

message {
  padding:          10px;
  border:           0px;
  background-color: #111111;
  text-color:       #888888;
}

textbox {
  background-color: inherit;
  text-color:       inherit;
  vertical-align:   0.5;
  horizontal-align: 0.5;
  markup:           true;
}

error-message {
  padding:          10px;
  background-color: #0a0a0a;
  text-color:       #e8e8e8;
}

listview {
  enabled:          true;
  columns:          5;
  lines:            1;
  cycle:            true;
  dynamic:          false;
  scrollbar:        false;
  layout:           vertical;
  fixed-height:     true;
  fixed-columns:    true;
  spacing:          10px;
  padding:          0px;
  background-color: transparent;
  text-color:       #e8e8e8;
}

element {
  padding:          18px 8px;
  border:           1px solid;
  border-radius:    0px;
  border-color:     #222222;
  background-color: #111111;
  text-color:       #aaaaaa;
  cursor:           pointer;
}

element-text {
  font:             "JetBrainsMono Nerd Font Mono 22";
  background-color: transparent;
  text-color:       inherit;
  cursor:           inherit;
  vertical-align:   0.5;
  horizontal-align: 0.5;
}

element selected.normal {
  background-color: #e8e8e8;
  text-color:       #0a0a0a;
  border-color:     #ffffff;
}