/**
 * monochrome-search
 */

* {
    font: "JetBrainsMono Nerd Font 13";

    bg:         #000000e6;
    bg-alt:     #0d0d0dff;
    bg-hover:   #161616ff;

    fg:         #f5f5f5ff;
    fg-dim:     #8a8a8aff;

    border:     #ffffff20;

    background-color: transparent;
    text-color: @fg;
}

window {
    transparency: "real";

    location: center;
    anchor: center;

    width: 550px;

    border: 1px;
    border-color: @border;

    border-radius: 0px;

    background-color: @bg;
}

mainbox {
    padding: 12px;
    spacing: 10px;

    children: [ inputbar, listview ];
}

/* SEARCH BAR */

inputbar {
    background-color: @bg-alt;

    border: 1px 1px 1px 1px;
    border-color: @border;

    padding: 14px;

    children: [ textbox-prompt-colon, entry ];
}

textbox-prompt-colon {
    expand: false;

    str: " ";

    font: "JetBrainsMono Nerd Font 13";

    text-color: #ffffff;

    margin: 0px 12px 0px 0px;
}

entry {
    background-color: transparent;

    text-color: @fg;

    placeholder: "Search...";
    placeholder-color: @fg-dim;
}

/* APPS */

listview {
    lines: 8;

    spacing: 6px;

    scrollbar: false;

    background-color: transparent;
}

element {
    padding: 12px;

    spacing: 14px;

    border-radius: 0px;

    background-color: transparent;

    text-color: @fg-dim;
}

element selected.normal {
    background-color: @bg-hover;

    border: 1px;
    border-color: #ffffff35;

    text-color: @fg;
}

element-icon {
    size: 28px;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

message {
    background-color: transparent;
}

textbox {
    background-color: transparent;
}